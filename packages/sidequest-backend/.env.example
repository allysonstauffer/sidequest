SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-backend-secret-key
SUPABASE_STORAGE_BUCKET=project-media

# Enable only after applying the email migrations and configuring a sender.
NOTIFICATION_EMAIL_ENABLED=false
SIDEQUEST_APP_URL=http://localhost:5173
NOTIFICATION_EMAIL_FROM=donotreply@gosidequesting.org
# Cloudflare Email Sending to arbitrary recipients requires Workers Paid.
# Choose cloudflare for its REST API, or smtp for an SMTP provider.
NOTIFICATION_EMAIL_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your-32-character-account-id
CLOUDFLARE_EMAIL_API_TOKEN=your-email-sending-api-token

# Only used with NOTIFICATION_EMAIL_PROVIDER=smtp.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Optional: use a legacy service-role key instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
