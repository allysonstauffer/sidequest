{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "sidequest-backend": {
      "root": "packages/sidequest-backend",
      "framework": "fastapi",
      "entrypoint": "post_handling.py"
    },
    "sidequest-frontend": {
      "root": "packages/sidequest-frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "sidequest-backend" } },
    { "source": "/(.*)", "destination": { "service": "sidequest-frontend" } }
  ]
}
