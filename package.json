{
  "name": "sidequest",
  "version": "1.0.0",
  "description": "A social media platform for hobbyists to share projects, discover communities, and connect with people who enjoy the same side quests.",
  "homepage": "https://github.com/allysonstauffer/sidequest#readme",
  "bugs": {
    "url": "https://github.com/allysonstauffer/sidequest/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allysonstauffer/sidequest.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:frontend && npm run test:backend && npm run test:database",
    "test:frontend": "npm test --workspace=sidequest-frontend",
    "test:backend": "python -m unittest discover -s packages/sidequest-backend -p \"test_*.py\"",
    "test:database": "node --test supabase/tests/*.test.mjs",
    "dev": "fastapi dev packages/sidequest-backend/post_handling.py",
    "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "prettier": "^3.9.6"
  }
}
